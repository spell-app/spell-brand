{
  // spell-brand's import-alias table (epic `repo-split` P8:  each repo has its own part of what was spell-app's one table).
  // Every package's `tsconfig.json` here extends it;  it extends the TypeScript settings every repo shares,
  // `@spell-app/toolchain`'s (spell-util's own toolchain package).
  // - `$/name` is a package's barrel, `$/name/...` a file in its `src/`:  for INSIDE this repo only.
  // - A package of ANOTHER repo is imported by its npm name (`@spell-app/util/class`), an entry its `package.json`
  //   `exports` names (WWOD §4, "Package names across repos").
  // - MUST stay the only `paths` in the repo:  a package that sets its own `paths` REPLACES this table, never adds to it.
  // - Paths are fixed, never `${configDir}`:  `tsx` can't resolve it.
  "extends": "@spell-app/toolchain/tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      // ## `brand`:  a component pack;  barrel and files;  its `<brand-*>` elements live in `components/`, outside `src/`, so
      // `$/brand/components` is longer than `$/brand/*` and wins
      "$/brand": ["./src/index.ts"],
      "$/brand/*": ["./src/*"],
      "$/brand/components": ["./components/index.ts"],
      "$/brand/components/*": ["./components/*"]
    }
  }
}
