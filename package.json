{
  "name": "spell-brand",
  "version": "0.0.0",
  "private": true,
  "description": "Spell's brand:  Claude Design's pages and tokens, their Spell UI copies, and the <brand-*> elements they need (a component pack)",
  "license": "MIT",
  "repository": "https://github.com/spell-app/spell-brand",
  "type": "module",
  "exports": {
    ".": {
      "spell-brand-source": "./src/index.ts",
      "types": "./dist-types/src/index.d.ts",
      "default": "./src/index.ts"
    },
    "./components": {
      "spell-brand-source": "./src/components/index.ts",
      "types": "./dist-types/src/components/index.d.ts",
      "default": "./src/components/index.ts"
    },
    "./components/brand-blob": {
      "spell-brand-source": "./src/components/brand-blob/index.ts",
      "types": "./dist-types/src/components/brand-blob/index.d.ts",
      "default": "./src/components/brand-blob/index.ts"
    },
    "./components/brand-checklist": {
      "spell-brand-source": "./src/components/brand-checklist/index.ts",
      "types": "./dist-types/src/components/brand-checklist/index.d.ts",
      "default": "./src/components/brand-checklist/index.ts"
    },
    "./components/brand-color": {
      "spell-brand-source": "./src/components/brand-color/index.ts",
      "types": "./dist-types/src/components/brand-color/index.d.ts",
      "default": "./src/components/brand-color/index.ts"
    },
    "./components/brand-color-picker": {
      "spell-brand-source": "./src/components/brand-color-picker/index.ts",
      "types": "./dist-types/src/components/brand-color-picker/index.d.ts",
      "default": "./src/components/brand-color-picker/index.ts"
    },
    "./components/brand-color-range": {
      "spell-brand-source": "./src/components/brand-color-range/index.ts",
      "types": "./dist-types/src/components/brand-color-range/index.d.ts",
      "default": "./src/components/brand-color-range/index.ts"
    },
    "./components/brand-color-set": {
      "spell-brand-source": "./src/components/brand-color-set/index.ts",
      "types": "./dist-types/src/components/brand-color-set/index.d.ts",
      "default": "./src/components/brand-color-set/index.ts"
    },
    "./components/brand-composer": {
      "spell-brand-source": "./src/components/brand-composer/index.ts",
      "types": "./dist-types/src/components/brand-composer/index.d.ts",
      "default": "./src/components/brand-composer/index.ts"
    },
    "./components/brand-flourish": {
      "spell-brand-source": "./src/components/brand-flourish/index.ts",
      "types": "./dist-types/src/components/brand-flourish/index.d.ts",
      "default": "./src/components/brand-flourish/index.ts"
    },
    "./components/brand-logo": {
      "spell-brand-source": "./src/components/brand-logo/index.ts",
      "types": "./dist-types/src/components/brand-logo/index.d.ts",
      "default": "./src/components/brand-logo/index.ts"
    },
    "./components/brand-phone": {
      "spell-brand-source": "./src/components/brand-phone/index.ts",
      "types": "./dist-types/src/components/brand-phone/index.d.ts",
      "default": "./src/components/brand-phone/index.ts"
    },
    "./*": {
      "spell-brand-source": [
        "./src/*.ts",
        "./src/*.tsx",
        "./src/*/index.ts",
        "./src/*/index.tsx",
        "./src/*"
      ],
      "types": [
        "./dist-types/src/*.d.ts",
        "./dist-types/src/*/index.d.ts"
      ],
      "default": "./src/*"
    },
    "./*.ts": {
      "spell-brand-source": "./src/*.ts",
      "types": "./dist-types/src/*.d.ts",
      "default": "./src/*.ts"
    },
    "./package.json": "./package.json",
    "./vite.config.ts": {
      "spell-brand-source": "./vite.config.ts",
      "types": "./dist-types/vite.config.d.ts",
      "default": "./vite.config.ts"
    }
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "compare": "tsx scripts/compare.ts",
    "site:data": "tsx scripts/site-data.ts",
    "/////// DESIGN": "",
    "design:bundle": "tsx scripts/design-bundle.ts",
    "design:check": "tsx scripts/design-check.ts",
    "/////// CORRECTNESS": "",
    "review": "yarn ts && yarn lint:fix && yarn format && yarn test && echo '== REVIEW PASSED\n===========\n'",
    "ts": "echo '>>>>>>>>>>>\n>> RUNNING TSC' && spell-types --below && spell-types && tsc -p ./tests && echo '<< TSC PASSED\n'",
    "lint": "echo '>>>>>>>>>>>\n>> LINTING WITH OXLINT' && vp lint --report-unused-disable-directives --max-warnings 0 src scripts && cd ./tests && vp lint --report-unused-disable-directives --max-warnings 0 . && echo '<< OXLINT PASSED\n'",
    "lint:fix": "echo '>>>>>>>>>>>\n>> LINTING WITH OXLINT --fix' && vp lint --fix src scripts && cd ./tests && vp lint --fix . && echo '<< OXLINT PASSED\n'",
    "format": "echo '>>>>>>>>>>>\n>> FORMATTING WITH OXFMT' && vp fmt src scripts vite.config.ts vite.design.config.ts vitest.config.ts _assets/brand-pages.js _assets/brand-pages.css && cd ./tests && vp fmt . && echo '<< OXFMT PASSED\n'",
    "/////// TESTING": "",
    "test": "echo '>>>>>>>>>>>\n>> RUNNING TESTS' && vp test run && echo '<< TESTS PASSED\n'",
    "pack:build": "spell-pack build",
    "pack:check": "spell-pack check",
    "postinstall": "node scripts/links.mjs"
  },
  "dependencies": {
    "spell": "portal:../spell"
  },
  "devDependencies": {
    "@solidjs/web": "2.0.0-rc.17",
    "@types/node": "^22.20.4",
    "@vitest/browser-playwright": "catalog:",
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.2",
    "playwright": "1.63.0",
    "solid-js": "2.0.0-rc.17",
    "tsx": "4.20.3",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.11"
  },
  "packageManager": "yarn@4.18.0",
  "customElements": "docs/__data/custom-elements.json",
  "spellTypes": [
    "tsconfig.json",
    "tsconfig.node.json"
  ],
  "spellPack": {
    "name": "brand",
    "prefix": "brand-",
    "components": "src/components"
  },
  "pageServer": {
    "watch": [
      ".",
      "src/components/__pack"
    ],
    "bundles": [
      "_assets/ui"
    ],
    "componentSets": {
      "brand": {
        "name": "Brand",
        "dir": "docs",
        "assets": "node_modules/spell/ui/site/_assets"
      }
    },
    "engineRoutes": {
      "/packages/brand/components/__pack/": "src/components/__pack",
      "/packages/brand/_assets/": "_assets",
      "/_brand/assets/": "assets",
      "/spell-brand/_assets/": "_assets"
    }
  },
  "resolutions": {
    "@solidjs/babel-plugin": "2.0.0-rc.17",
    "@solidjs/compiler": "2.0.0-rc.17",
    "@solidjs/h": "2.0.0-rc.17",
    "@solidjs/signals": "2.0.0-rc.17",
    "@solidjs/web": "2.0.0-rc.17",
    "axe-core": "4.13.0",
    "solid-js": "2.0.0-rc.17",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vitest": "5.0.1"
  }
}
