{
  // spell-brand's NODE code, ONE TypeScript program (epic `repo-split` P14, Q47):  what's outside `src/`, its
  // `scripts/` (the bundles' builds, the docs data, the design bundle and its check, `compare`) and the Vite configs.
  // - As `tsconfig.json`, but node's types too:  the configs and the design bundle's build reach the brand's and
  //   Spell UI's browser source, so they keep the DOM, Vite's client types and the JSX settings.
  // - The declarations build (`spell-types`) builds it into `dist-types/` too, beside the browser program's.
  "extends": "spell/toolchain/tsconfig.base.json",
  "compilerOptions": {
    "customConditions": ["spell-brand-source"],
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "types": ["node", "vite/client"]
  },
  "include": ["scripts", "vite.config.ts", "vite.design.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules"]
}
